@media (max-width: 400px) {
	.product-type {
		/* display: grid;
		grid-template-columns: auto auto auto auto; */
		grid-template-columns: repeat(4, 1fr);
		margin: auto;
	}
	.nav-container {
		margin-bottom: 20px;
		height: 200px;
	}
	.nav-container h1 {
		margin-top: 0px;
	}
	.main-nav {
		margin: 0px;
		font-size: 14px;
	}

	input {
		width: 100%;
	}
}

@media (max-width: 700px) {
	.product-type {
		display: grid;
		grid-template-columns: auto auto auto auto;
		grid-gap: 10px;
		/* padding: 10px; */
		/* grid-template-columns: repeat(4, 1fr);
		margin: auto; */
	}
	.nav-container img {
		height: 30px;
		width: 30px;
	}
	.nav-container h1 {
		margin-top: 0px;
	}
	/* input {
		width: 100px;
	} */
}

@media (min-width: 701px) {
	.header {
		top: 10px;
		position: absolute;
		/* display: flex; */
		justify-content: space-between;
		width: 100%;
	}

	.nav-container h1 {
		/* margin-top: 100px; */
		font-size: 3.5em;
	}
	.nav-container,
	.main-nav {
		display: flex;
	}

	.nav-container {
		/* flex-direction: column; */
		align-items: center;
		margin: 0 auto;
		margin-bottom: 40px;
	}
}

@media (min-width: 1025px) {
	.nav-container {
		/* flex-direction: column; */
		justify-content: space-between;
	}
}
